{
  "version": 8,
  "name": "Sovereign Florida",

  "glyphs": "http://localhost:5000/fonts/{fontstack}/{range}.pbf",
  "sprite": "http://localhost:5000/sprites/sprite",

  "sources": {
    "sovereign": {
      "type": "vector",
      "tiles": [
        "http://localhost:5000/tiles/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 0,
      "maxzoom": 18,
      "scheme": "xyz",
      "bounds": [-88.0, 24.0, -79.0, 32.0]
    },

    "rover": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },

  "layers": [

    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f2efe9"
      }
    },

    {
      "id": "water-fill",
      "type": "fill",
      "source": "sovereign",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a0c8f0"
      }
    },

    {
      "id": "roads-major",
      "type": "line",
      "source": "sovereign",
      "source-layer": "roads",
      "minzoom": 6,
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary"
      ],
      "paint": {
        "line-color": "#d18f5f",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 0.4,
          10, 2.0,
          14, 4.0,
          18, 10.0
        ]
      }
    },

    {
      "id": "roads-minor",
      "type": "line",
      "source": "sovereign",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": [
        "!in",
        "class",
        "motorway",
        "trunk",
        "primary"
      ],
      "paint": {
        "line-color": "#d8a67a",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 0.3,
          14, 1.2,
          18, 4.0
        ]
      }
    },

    {
      "id": "buildings-fill",
      "type": "fill",
      "source": "sovereign",
      "source-layer": "buildings",
      "minzoom": 12,
      "paint": {
        "fill-color": "#dcdcdc",
        "fill-opacity": 0.7
      }
    },

    {
      "id": "buildings-outline",
      "type": "line",
      "source": "sovereign",
      "source-layer": "buildings",
      "minzoom": 12,
      "paint": {
        "line-color": "#b0b0b0",
        "line-width": 0.5
      }
    },

    {
      "id": "rover-position",
      "type": "symbol",
      "source": "rover",
      "layout": {
        "icon-image": "rover-icon",
        "icon-size": 1.0,
        "icon-allow-overlap": true
      }
    }
  ]
}
