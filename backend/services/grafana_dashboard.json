{
  "id": null,
  "uid": "rf-ml-anomalies",
  "title": "RF Observatory - ML Anomalies",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "table",
      "title": "Recent Anomalies",
      "datasource": "RF SQLite",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 10 },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT frame_timestamp, src_mac, channel, frame_type, anomaly_score, anomaly_severity, anomaly_cluster, device_deviation, channel_deviation FROM anomalies ORDER BY frame_timestamp DESC LIMIT 200;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": {} },
        "overrides": []
      }
    },
    {
      "type": "graph",
      "title": "Anomaly Score Over Time",
      "datasource": "RF SQLite",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT strftime('%s', frame_timestamp) * 1000 AS time, anomaly_score AS value FROM anomalies ORDER BY frame_timestamp DESC LIMIT 500;",
          "metricColumn": "none"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "points": true
    },
    {
      "type": "piechart",
      "title": "Anomaly Severity Distribution",
      "datasource": "RF SQLite",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT anomaly_severity AS metric, COUNT(*) AS value FROM anomalies GROUP BY anomaly_severity;"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Anomaly Cluster Distribution",
      "datasource": "RF SQLite",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT anomaly_cluster AS metric, COUNT(*) AS value FROM anomalies GROUP BY anomaly_cluster;"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Devices by Deviation",
      "datasource": "RF SQLite",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT src_mac, MAX(device_deviation) AS max_device_deviation FROM anomalies GROUP BY src_mac ORDER BY max_device_deviation DESC LIMIT 20;"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Channels by Deviation",
      "datasource": "RF SQLite",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT channel, MAX(channel_deviation) AS max_channel_deviation FROM anomalies GROUP BY channel ORDER BY max_channel_deviation DESC LIMIT 20;"
        }
      ]
    }
  ]
}
