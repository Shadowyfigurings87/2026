{
  "dashboard": {
    "id": null,
    "title": "RF Observatory Dashboard",
    "tags": ["rf", "observatory", "metrics"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "type": "graph",
        "title": "Total Frames Over Time",
        "targets": [
          { "expr": "frames_total", "legendFormat": "Total Frames" }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
      },
      {
        "type": "graph",
        "title": "Frames by Type",
        "targets": [
          { "expr": "frames_control", "legendFormat": "Control" },
          { "expr": "frames_management", "legendFormat": "Management" },
          { "expr": "frames_data", "legendFormat": "Data" }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
      },
      {
        "type": "gauge",
        "title": "Average RSSI",
        "targets": [
          { "expr": "rssi_avg", "legendFormat": "Avg RSSI" }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 }
      },
      {
        "type": "gauge",
        "title": "Min RSSI",
        "targets": [
          { "expr": "rssi_min", "legendFormat": "Min RSSI" }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 }
      },
      {
        "type": "gauge",
        "title": "Max RSSI",
        "targets": [
          { "expr": "rssi_max", "legendFormat": "Max RSSI" }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 12, "y": 8, "w": 6, "h": 6 }
      },
      {
        "type": "graph",
        "title": "Anomaly Scores",
        "targets": [
          { "expr": "anomaly_score", "legendFormat": "Score" }
        ],
        "datasource": "Prometheus",
        "gridPos": { "x": 18, "y": 8, "w": 6, "h": 6 }
      },
      {
        "type": "table",
        "title": "Recent Frames",
        "targets": [
          {
            "expr": "recent_frame_info",
            "legendFormat": "{{src}} → {{dst}}"
          }
        ],
        "datasource": "Prometheus",
        "columns": [
          { "text": "Timestamp", "value": "timestamp" },
          { "text": "Source", "value": "src" },
          { "text": "Destination", "value": "dst" },
          { "text": "Type", "value": "frame_type" },
          { "text": "Subtype", "value": "subtype" },
          { "text": "RSSI", "value": "rssi" },
          { "text": "Signal Quality", "value": "signal_quality" }
        ],
        "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 }
      }
    ]
  }
}
{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "rf_observatory_alerts",
      "interval": "30s",
      "rules": [
        {
          "uid": "low-rssi",
          "title": "Low RSSI",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "prometheus",
              "relativeTimeRange": { "from": 600, "to": 0 },
              "datasourceUid": "your-prometheus-datasource-uid",
              "model": {
                "expr": "rssi_avg",
                "interval": "",
                "legendFormat": "Avg RSSI",
                "refId": "A"
              }
            }
          ],
          "conditions": [
            {
              "evaluator": { "type": "lt", "params": [-85] },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "type": "last" },
              "type": "query"
            }
          ],
          "noDataState": "alerting",
          "execErrState": "alerting",
          "for": "2m",
          "annotations": {
            "summary": "Average RSSI is too low",
            "description": "RSSI average dropped below -85 for 2 minutes."
          },
          "labels": { "severity": "warning" }
        },
        {
          "uid": "high-anomaly",
          "title": "High Anomaly Score",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "prometheus",
              "relativeTimeRange": { "from": 300, "to": 0 },
              "datasourceUid": "your-prometheus-datasource-uid",
              "model": {
                "expr": "anomaly_score",
                "interval": "",
                "legendFormat": "Score",
                "refId": "A"
              }
            }
          ],
          "conditions": [
            {
              "evaluator": { "type": "gt", "params": [0.8] },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "type": "last" },
              "type": "query"
            }
          ],
          "noDataState": "alerting",
          "execErrState": "alerting",
          "for": "1m",
          "annotations": {
            "summary": "High anomaly score detected",
            "description": "Anomaly score exceeded 0.8 for 1 minute."
          },
          "labels": { "severity": "critical" }
        }
      ]
    }
  ]
}
