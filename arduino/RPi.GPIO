# ⚡ Sovereign Pi Control Script ⚡
# Zachariah's capsule-grade vessel: PWM control, PG pulse RPM tracking
# Extended with BTS7960 actuator subsystem + Optocoupler F/R control

import RPi.GPIO as GPIO
import time
import sys

# GPIO pin mapping (adjust as needed)
PWM_PIN = 6      # Hardware PWM capable pin (BCM numbering)
PG_PIN = 2       # PG signal input
RPWM = 7
LPWM = 8
R_EN = 22
L_EN = 23
FR_CTRL = 24

# State variables
last_pulse_time = 0
pulse_interval = 0
rpm = 0.0
motor_poles = 4
last_update_time = 0

# Setup
GPIO.setmode(GPIO.BCM)
GPIO.setup(PWM_PIN, GPIO.OUT)
GPIO.setup(PG_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)

GPIO.setup(RPWM, GPIO.OUT)
GPIO.setup(LPWM, GPIO.OUT)
GPIO.setup(R_EN, GPIO.OUT)
GPIO.setup(L_EN, GPIO.OUT)
GPIO.setup(FR_CTRL, GPIO.OUT)

# PWM objects
pwm_main = GPIO.PWM(PWM_PIN, 1000)  # 1kHz base frequency
pwm_main.start(0)

pwm_r = GPIO.PWM(RPWM, 1000)
pwm_l = GPIO.PWM(LPWM, 1000)
pwm_r.start(0)
pwm_l.start(0)

GPIO.output(R_EN, GPIO.HIGH)
GPIO.output(L_EN, GPIO.HIGH)
GPIO.output(FR_CTRL, GPIO.LOW)

print("⚡ Sovereign Capsule Booting...")

# PG pulse handler
def on_pg_pulse(channel):
    global last_pulse_time, pulse_interval, last_update_time
    now = time.time()
    if last_pulse_time > 0:
        pulse_interval = now - last_pulse_time
    last_pulse_time = now
    last_update_time = time.time()

GPIO.add_event_detect(PG_PIN, GPIO.RISING, callback=on_pg_pulse)

# Command loop
try:
    while True:
        # Check for input from terminal
        if sys.stdin in select.select([sys.stdin], [], [], 0)[0]:
            cmd = sys.stdin.readline().strip()
            print(f"CMD Received: {cmd}")

            if cmd.startswith("ACT:FWD:"):
                speed = int(cmd[8:])
                speed = max(0, min(speed, 100))  # duty cycle %
                pwm_r.ChangeDutyCycle(speed)
                pwm_l.ChangeDutyCycle(0)
                print(f"ACK:ACT:FWD:{speed}")
            elif cmd.startswith("ACT:REV:"):
                speed = int(cmd[8:])
                speed = max(0, min(speed, 100))
                pwm_l.ChangeDutyCycle(speed)
                pwm_r.ChangeDutyCycle(0)
                print(f"ACK:ACT:REV:{speed}")
            elif cmd.startswith("ACT:STOP"):
                pwm_r.ChangeDutyCycle(0)
                pwm_l.ChangeDutyCycle(0)
                print("ACK:ACT:STOP")
            elif cmd.startswith("PWM:"):
                val = int(cmd[4:])
                val = max(0, min(val, 100))
                pwm_main.ChangeDutyCycle(val)
                print(f"ACK:PWM:{val}")
            elif cmd.startswith("DIR:FWD"):
                GPIO.output(FR_CTRL, GPIO.LOW)
                print("ACK:DIR:FWD")
            elif cmd.startswith("DIR:REV"):
                GPIO.output(FR_CTRL, GPIO.HIGH)
                print("ACK:DIR:REV")
            else:
                print("ERR:Unknown command")

        # RPM calculation
        now = time.time()
        if pulse_interval > 0:
            freq = 1.0 / pulse_interval
            rpm = (freq * 60) / (2 * motor_poles)
        if now - last_update_time > 1.0:
            rpm = 0.0

        # Print RPM every 0.5s
        if int(now * 2) % 1 == 0:  # crude 500ms tick
            if rpm > 0.0:
                print(f"RPM:{rpm:.2f}")
            else:
                print("RPM:STOP")
        time.sleep(0.05)

except KeyboardInterrupt:
    pass
finally:
    pwm_main.stop()
    pwm_r.stop()
    pwm_l.stop()
    GPIO.cleanup()
